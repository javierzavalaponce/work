arm_length=250; //mm
pendulo_length=230;
pared=2;
diam_tubo=19;

module arm(){
  rotate([90,0,0])
  difference(){
    cylinder(h=arm_length,r=diam_tubo/2.0,center=false);
    cylinder(h=arm_length+1,r=(diam_tubo/2.0)-pared,center=false);
  } 
}

module pendulo(){
 union(){
   cylinder(h=225,r=5,center=false);
   cylinder(h=50,r=15,center=false);
 }
}
 

color("orangered")
arm();
color("gray")
pendulo();

