sudo apt install zathura zathura-pdf-poppler
mkdir -p ~/.config/zathura
vim zathurarc:

# Alternar color invertido con Ctrl+i 
map <C-i> recolor

# Ajustes que sí funcionan
set adjust-open-width true
set scroll-page-aware true
set recolor-lightcolor "#1e1e2e"
set recolor-darkcolor "#cdd6f4"
set statusbar-bg "#313244"
set statusbar-fg "#89b4fa"
set statusbar-h-padding 8


